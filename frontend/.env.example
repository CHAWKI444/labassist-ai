# Copy to frontend/.env.local if you need to override the defaults. Never put secrets here:
# every VITE_* value is embedded in the browser bundle.

# Development only: where the Vite dev server proxies /api (default http://127.0.0.1:8000).
VITE_BACKEND_URL=http://127.0.0.1:8000

# Production builds: absolute backend origin when the API is not served from the same origin as the
# frontend (e.g. https://api.lab.example.org). Leave empty to call /api on the same origin.
# The backend's CORS_ORIGINS must then include the frontend origin.
VITE_API_BASE_URL=
