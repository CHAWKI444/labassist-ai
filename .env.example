# Copy to .env (repository root) and fill in the values. Never commit .env.

# ---------- Security ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=120
ALLOW_SELF_REGISTRATION=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- PostgreSQL ----------
DATABASE_URL=postgresql+psycopg2://labassist:CHANGE_ME@localhost:5432/labassist

# ---------- Ollama (local LLM) ----------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=mistral
# Context window requested from Ollama (tokens). The CAG budget is capped to fit inside it.
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT_SECONDS=300
LLM_TEMPERATURE=0.2
LLM_MAX_ANSWER_TOKENS=512

# ---------- Embeddings (BAAI/bge-m3) ----------
# "ollama" uses `ollama pull bge-m3`; "sentence-transformers" loads BAAI/bge-m3 in-process
# (pip install -r backend/requirements-st.txt, then set EMBEDDING_MODEL=BAAI/bge-m3).
EMBEDDING_BACKEND=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_BATCH_SIZE=16

# ---------- RAG ----------
MAX_UPLOAD_MB=20
CHUNK_SIZE_CHARS=1000
CHUNK_OVERLAP_CHARS=150
RAG_TOP_K=4
# Minimum cosine similarity for a passage to be used as evidence.
RAG_MIN_SCORE=0.45

# ---------- CAG ----------
CAG_MAX_CONTEXT_TOKENS=1500

# ---------- MAG ----------
MEMORY_RETENTION_DAYS=180
MEMORY_MAX_PER_USER=50
MEMORY_MAX_CHARS=300

# ---------- Metrics ----------
METRICS_RETENTION_DAYS=90
# Dashboard alerts (only raised once the window holds ALERT_MIN_REQUESTS chat requests)
ALERT_MIN_REQUESTS=5
ALERT_P95_MS=60000
ALERT_ERROR_RATE_PCT=10
ALERT_NO_SOURCE_RATE_PCT=30

# ---------- LabVision AI (dataset quality & anomaly detection) ----------
# Uploaded CSV/Excel files are parsed in memory only and kept there for LABVISION_DATASET_TTL_MINUTES.
LABVISION_MAX_UPLOAD_MB=10
LABVISION_MAX_ROWS=100000
LABVISION_MAX_COLUMNS=200
LABVISION_DATASET_TTL_MINUTES=30
LABVISION_MAX_DATASETS_PER_USER=3
# Findings stored per analysis (highest severity first); counts always include every finding.
LABVISION_MAX_FINDINGS=5000
# Computed results and review decisions are deleted after this many days.
LABVISION_RETENTION_DAYS=30

# ---------- Invitations & email ----------
# Base URL of the React app, used to build invitation links (<FRONTEND_BASE_URL>/invite#token=...).
FRONTEND_BASE_URL=http://localhost:5173
INVITATION_EXPIRE_HOURS=72
# "outbox" (development) writes .eml files to backend/data/outbox instead of sending.
# "smtp" sends real email with the settings below (any SMTP provider: Gmail/Workspace, Microsoft 365, Mailgun, SendGrid...).
EMAIL_BACKEND=outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=LabAssist AI <no-reply@labassist.local>
# Port 587 = STARTTLS (SMTP_STARTTLS=true). Port 465 = implicit TLS (SMTP_SSL=true, SMTP_STARTTLS=false).
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=15

# ---------- Seed script only (python -m app.scripts.seed) ----------
ADMIN_EMAIL=admin@labassist.local
ADMIN_PASSWORD=
DEMO_USER_PASSWORD=
